    {
      "id": 2,
      "type": "stat",
      "title": "Сбор метрик",
      "description": "Последний результат опроса /metrics. Prometheus опрашивает магазин каждые 15 секунд.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "qa-shop-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "—",
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Недоступно",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Работает",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "qa-shop-prometheus"
          },
          "editorMode": "code",
          "expr": "min(up{job=\"qa-shop\"}) or vector(0)",
          "legendFormat": "Сбор",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Запросы API в секунду",
      "description": "Скорость за 5 минут по известным маршрутам API, без запроса проверки состояния.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "qa-shop-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "—",
          "min": 0,
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "qa-shop-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{job=\"qa-shop\",route=~\"/api/.*\",route!=\"/api/health\"}[5m])) or (0 * max(up{job=\"qa-shop\"} == 1))",
          "legendFormat": "Запросы",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Доля HTTP 5xx",
      "description": "Доля ответов API с кодом 5xx за 5 минут. При отсутствии трафика значение не рассчитывается.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "qa-shop-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "—",
          "min": 0,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "qa-shop-prometheus"
          },
          "editorMode": "code",
          "expr": "((sum(rate(http_requests_total{job=\"qa-shop\",route=~\"/api/.*\",route!=\"/api/health\",status=~\"5..\"}[5m]))) or (0 * sum(rate(http_requests_total{job=\"qa-shop\",route=~\"/api/.*\",route!=\"/api/health\"}[5m])))) / (sum(rate(http_requests_total{job=\"qa-shop\",route=~\"/api/.*\",route!=\"/api/health\"}[5m])) > 0)",
          "legendFormat": "HTTP 5xx",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "p95 задержки API",
      "description": "Приблизительная граница, в которую укладываются 95 % запросов API за 5 минут.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "qa-shop-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "—",
          "min": 0,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 250
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "qa-shop-prometheus"
          },
          "editorMode": "code",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"qa-shop\",route=~\"/api/.*\",route!=\"/api/health\"}[5m]))) and on() (sum(rate(http_request_duration_seconds_count{job=\"qa-shop\",route=~\"/api/.*\",route!=\"/api/health\"}[5m])) > 0)",
          "legendFormat": "p95",
          "instant": true,
          "range": false
        }
      ]
    },
